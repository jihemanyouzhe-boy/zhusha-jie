<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>自省录</title><style>body{margin:0;background:#f5f0e6;color:#191817;font-family:Arial,'Microsoft Yahei',sans-serif}nav{padding:20px 7%;border-bottom:1px solid #d8cfbf}.logo{font-size:26px;font-weight:900;letter-spacing:4px}.seal{background:#a51c1c;color:white;padding:6px;margin-right:9px}main{padding:80px 9%;min-height:70vh}h1{font-size:clamp(50px,8vw,92px);line-height:1.1;margin:20px 0}i{color:#a51c1c;font-style:normal}.eyebrow{color:#a51c1c;letter-spacing:6px;font-size:12px;font-weight:bold}.lead{max-width:620px;color:#756f65;line-height:2}button{padding:12px 20px;border:1px solid #191817;background:none;cursor:pointer}.red{background:#a51c1c;color:#fff;border-color:#a51c1c}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:14px;margin-top:40px}.card{padding:20px;background:#fffaf1;border:1px solid #d8cfbf;min-height:100px}.card:hover{border-color:#a51c1c;transform:translateY(-3px)}h2{font-size:34px;margin-top:80px}.boards{display:grid;grid-template-columns:1fr 1fr;gap:20px}.board{background:#fffaf1;padding:20px;border-top:5px solid #2d6049}.black{border-color:#191817}.row{padding:14px;border-bottom:1px solid #ddd;color:#555}@media(max-width:750px){.grid{grid-template-columns:repeat(2,1fr)}.boards{grid-template-columns:1fr}}@media(max-width:450px){.grid{grid-template-columns:1fr}}#modal{display:none;position:fixed;inset:0;background:#0009;place-items:center}#modal.show{display:grid}.dialog{background:#f5f0e6;padding:30px;width:min(400px,85%);border-top:5px solid #a51c1c}.dialog input,.dialog select{width:100%;padding:12px;margin:8px 0 14px;box-sizing:border-box}.toast{position:fixed;bottom:25px;left:50%;background:#191817;color:white;padding:12px;transform:translateX(-50%);display:none}.toast.show{display:block}</style></head><body><nav><div class="logo"><span class="seal">省</span>自省录</div></nav><main><div class="eyebrow">清醒 · 自律 · 长期主义</div><h1>克己复礼<br>向<i>清醒</i>而生</h1><p class="lead">这里不贩卖焦虑，也不许诺奇迹。记录、反思、彼此照亮，把注意力重新还给生活。</p><button class="red" onclick="openAuth('register')">立下今日之志</button> <button onclick="openAuth('login')">登录</button><h2>十六种修习模式</h2><div class="grid" id="modes"></div><h2>戒色红黑榜</h2><div class="boards"><div class="board"><h3>红榜 · 笃行者</h3><div class="row">松间明月　浙江 · 连续 186 天</div><div class="row">向山而行　广东 · 连续 93 天</div><div class="row">无问西东　四川 · 连续 67 天</div></div><div class="board black"><h3>黑榜 · 反省录</h3><div class="row">匿名甲　深夜失守 · 已复盘</div><div class="row">匿名乙　压力过大 · 重新出发</div><div class="row">匿名丙　独处失守 · 调整环境</div></div></div></main><div id="modal"><div class="dialog"><button onclick="modal.classList.remove('show')">关闭</button><h2 id="title">登录</h2><form onsubmit="submitForm(event)"><label>同修名</label><input required placeholder="请输入昵称"><div id="regionBox"><label>所在地区（注册必填）</label><select required><option value="">请选择地区</option><option>北京</option><option>上海</option><option>广东</option><option>江苏</option><option>浙江</option><option>四川</option><option>湖北</option><option>其他地区</option></select></div><label>密码</label><input required type="password" minlength="6"><button class="red" type="submit">提交</button></form></div></div><div id="toast" class="toast"></div><script>const names=['晨钟计划','净屏模式','七日初心','三十日筑基','九十日重塑','运动破局','冷静呼吸','夜航守门','独处护盾','学业专注','同伴互助','情绪日记','紧急转场','古训晨读','数字极简','周日复盘'];modes.innerHTML=names.map((n,i)=>`<div class="card" onclick="notice('已选择「${n}」')"><b>${String(i+1).padStart(2,'0')} · ${n}</b><p>从今天开始，温和地练习清醒。</p></div>`).join('');let register=false;function openAuth(x){register=x==='register';modal.classList.add('show');title.textContent=register?'注册并加入同修':'登录';regionBox.style.display=register?'block':'none';regionBox.querySelector('select').required=register}function submitForm(e){e.preventDefault();modal.classList.remove('show');notice(register?'注册成功，欢迎加入同修':'登录成功，欢迎回来')}function notice(t){toast.textContent=t;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),2000)}</script></body></html>